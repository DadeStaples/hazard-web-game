@page "/register"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using Hazard_game_application.Models
@using System.Net
@inject IJSRuntime JS
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<h3>Register</h3>

<EditForm Model="newUser" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrEmpty(registrationError))
    {
        <div class="alert alert-danger">@registrationError</div>
    }

    <div class="mb-3">
        <label class="form-label">Username</label>
        <InputText class="form-control w-auto" @bind-Value="newUser.Username" />
        <ValidationMessage For="@(() => newUser.Username)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText type="password" class="form-control w-auto" @bind-Value="newUser.Password" />
        <ValidationMessage For="@(() => newUser.Password)" />
    </div>


    <button type="submit" class="btn btn-primary me-2">
        Register
    </button>

    <button type="button"
    class="btn btn-link"
    @onclick='() => Navigation.NavigateTo("/login")'>
        Cancel
    </button>
</EditForm>

@code {
    private User newUser = new();
    private string? registrationError;


    private async Task HandleRegister()
    {
        try
        {
            var createResp = await Http.PostAsJsonAsync("api/users", newUser);

            if (createResp.StatusCode == HttpStatusCode.Conflict)
            {
                registrationError = "That username is already in use.";
                return;
            }
            createResp.EnsureSuccessStatusCode();

            var loginResp = await Http.PostAsJsonAsync("api/auth/login", new
            {
                Username = newUser.Username,
                Password = newUser.Password
            });
            loginResp.EnsureSuccessStatusCode();

            var loginResult = await loginResp.Content.ReadFromJsonAsync<TokenResponse>();
            await LocalStorage.SetItemAsync("authToken", loginResult.Token);

            ((JwtAuthenticationStateProvider)AuthProvider)
                .NotifyUserAuthentication(loginResult.Token);

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Registration failed: {ex.Message}");
        }
    }

    private class TokenResponse { public string Token { get; set; } }
}
